<!DOCTYPE html>
<html lang="nl">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Spelen.nl - Game Hub</title>
        <!-- Bootstrap 5.3 CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <!-- Bootstrap Icons -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
        <!-- Google Fonts -->
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
        <style>
            body {
                font-family: "Outfit", sans-serif;
                background-color: #0f172a;
                color: #f8fafc;
                overflow-x: hidden;
            }
            .navbar-custom {
                background: rgba(15, 23, 42, 0.95);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }
            .gaming-card {
                background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 1rem;
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            }
            .hero-banner {
                background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
                border-radius: 1.25rem;
                position: relative;
                overflow: hidden;
            }
            .game-card-hover {
                transition:
                    transform 0.2s ease,
                    border-color 0.2s ease;
                background: #1e293b;
                border: 1px solid rgba(255, 255, 255, 0.05);
            }
            .game-card-hover:hover {
                transform: translateY(-3px);
                border-color: #6366f1;
            }
            .leaderboard-item {
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid rgba(255, 255, 255, 0.05);
                border-radius: 0.75rem;
            }
        </style>
    </head>
    <body>

        <!-- Navbar -->
        <nav class="navbar navbar-dark navbar-custom sticky-top py-3">
            <div class="container d-flex justify-content-between align-items-center">
                <a class="navbar-brand fw-bold text-info fs-5 fs-md-4 mb-0 text-decoration-none" href="#">
                    <i class="bi bi-controller text-warning"></i> Spelen<span class="text-white">.nl</span>
                </a>
                <div class="d-flex align-items-center gap-2 gap-sm-3">
                    <span class="text-secondary small d-none d-sm-inline">Ingelogd: <strong class="text-white">{{ username }}</strong></span>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm rounded-pill px-3 py-1">
                        <i class="bi bi-box-arrow-right"></i> <span class="d-none d-xs-inline">Uitloggen</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Main Container -->
        <div class="container py-3 py-md-5">

            <!-- Hero Banner -->
            <div class="hero-banner p-4 p-md-5 mb-4 mb-md-5 text-white shadow-lg">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <span class="badge bg-white text-dark mb-2 fw-semibold px-3 py-1 rounded-pill">Seizoen 2026</span>
                        <h1 class="fw-extrabold mb-2 fs-2 fs-md-1">Game Arena</h1>
                        <p class="text-white-50 mb-0 small fs-md-base">Neem het tegen elkaar op, breek elkaars records en kroon jezelf tot de ultieme kampioen.</p>
                    </div>
                    <div class="col-lg-4 text-end d-none d-lg-block">
                        <i class="bi bi-trophy-fill text-warning display-1 opacity-75"></i>
                    </div>
                </div>
            </div>

            <div class="row g-3 g-md-4">
            
                <!-- Linkerkolom: Statistieken & Live Tussenstand -->
                <div class="col-lg-4 d-flex flex-column gap-3 gap-md-4">
                
                    <!-- Jouw Score Kaart -->
                    <div class="gaming-card p-3 p-md-4 text-center">
                        <div class="mb-1 mb-md-2 text-warning fs-2 fs-md-1"><i class="bi bi-award-fill"></i></div>
                        <h6 class="text-secondary text-uppercase tracking-wider small fw-bold mb-1">Jouw Punten</h6>
                        <h2 class="display-4 fw-bold text-info mb-0">{{ totalPoints }}</h2>
                    </div>

                    <!-- Live Tussenstand (Leaderboard) -->
                    <div class="gaming-card p-3 p-md-4">
                        <h5 class="fw-bold mb-3 text-white d-flex align-items-center justify-content-between fs-6 fs-md-5">
                            <span><i class="bi bi-graph-up-arrow text-success"></i> Tussenstand</span>
                            <span class="badge bg-success bg-opacity-10 text-success small border border-success border-opacity-25">Live</span>
                        </h5>
                    
                        <div class="d-flex flex-column gap-2 gap-md-3">
                            <!-- Arda -->
                            <div class="leaderboard-item p-2.5 p-md-3 d-flex align-items-center justify-content-between {{ username == 'Arda' ? 'border-info border-opacity-50 bg-info bg-opacity-10' : '' }}">
                                <div class="d-flex align-items-center gap-2 gap-md-3">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">A</div>
                                    <div>
                                        <h6 class="mb-0 fw-bold fs-sm">Arda</h6>
                                        <small class="text-secondary" style="font-size: 0.75rem;">Speler</small>
                                    </div>
                                </div>
                                <span class="fs-5 fw-bold text-warning">{{ ardaTotal }} <small class="fs-6 text-secondary">pts</small></span>
                            </div>

                            <!-- Irem -->
                            <div class="leaderboard-item p-2.5 p-md-3 d-flex align-items-center justify-content-between {{ username == 'Irem' ? 'border-info border-opacity-50 bg-info bg-opacity-10' : '' }}">
                                <div class="d-flex align-items-center gap-2 gap-md-3">
                                    <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">I</div>
                                    <div>
                                        <h6 class="mb-0 fw-bold fs-sm">Irem</h6>
                                        <small class="text-secondary" style="font-size: 0.75rem;">Speler</small>
                                    </div>
                                </div>
                                <span class="fs-5 fw-bold text-warning">{{ iremTotal }} <small class="fs-6 text-secondary">pts</small></span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Rechterkolom: Spellen Overzicht -->
                <div class="col-lg-8">
                    <div class="gaming-card p-3 p-md-4 h-100">
                        <h3 class="fw-bold mb-3 mb-md-4 text-white fs-5 fs-md-4"><i class="bi bi-grid-fill text-primary"></i> Kies je Game</h3>
                    
                        <div class="row g-3 g-md-4">
                            <!-- 1. Quiz -->
                            <div class="col-md-4">
                                <div class="card game-card-hover h-100 p-3 p-md-4 rounded-4 text-white d-flex flex-column">
                                    <div class="mb-2 text-info fs-3"><i class="bi bi-question-circle-fill"></i></div>
                                    <h4 class="fw-bold fs-5">Quiz</h4>
                                    <p class="text-secondary small mb-3 flex-grow-1">Beantwoord uitdagende vragen en scoor punten.</p>
                                    <a href="{{ path('app_quiz') }}" class="btn btn-outline-info btn-sm rounded-pill mt-auto w-100 py-2"><i class="bi bi-play-fill"></i> Speel Nu</a>
                                </div>
                            </div>

                            <!-- 2. Wordle Duel -->
                            <div class="col-md-4">
                                <div class="card game-card-hover h-100 p-3 p-md-4 rounded-4 text-white d-flex flex-column">
                                    <div class="mb-2 text-warning fs-3"><i class="bi bi-puzzle-fill"></i></div>
                                    <h4 class="fw-bold fs-5">Wordle</h4>
                                    <p class="text-secondary small mb-3 flex-grow-1">Raad het woord dat de ander voor je heeft bedacht.</p>
                                    <a href="{{ path('app_wordle') }}" class="btn btn-outline-warning btn-sm rounded-pill mt-auto w-100 py-2"><i class="bi bi-play-fill"></i> Speel Wordle</a>
                                </div>
                            </div>

                            <!-- 3. Wie Kent Wie? -->
                            <div class="col-md-4">
                                <div class="card game-card-hover h-100 p-3 p-md-4 rounded-4 text-white d-flex flex-column">
                                    <div class="mb-2 text-danger fs-3"><i class="bi bi-people-fill"></i></div>
                                    <h4 class="fw-bold fs-5">Wie Kent Wie?</h4>
                                    <p class="text-secondary small mb-3 flex-grow-1">Beantwoord stellingen over jezelf en voorspel elkaars antwoorden.</p>
                                    <a href="{{ path('app_duel') }}" class="btn btn-outline-danger btn-sm rounded-pill mt-auto w-100 py-2"><i class="bi bi-play-fill"></i> Speel Direct</a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>

    </body>
</html>
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spelen.nl - Quiz Game</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }
        .gaming-card {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 1rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .form-check-input:checked {
            background-color: #6366f1;
            border-color: #6366f1;
        }
    </style>
</head>
<body class="py-4 py-md-5">

    <div class="container" style="max-width: 700px;">
        
        <!-- Header / Terugknop -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="{{ path('app_home') }}" class="btn btn-outline-light btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Terug naar Hub
            </a>
            <span class="text-secondary small">Speler: <strong class="text-white">{{ username }}</strong></span>
        </div>

        <div class="gaming-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="text-info fs-1 mb-2"><i class="bi bi-question-circle-fill"></i></div>
                <h2 class="fw-bold">Symfony &amp; Tech Quiz</h2>
                <p class="text-secondary small">Beantwoord de vragen correct en verdien 10 punten per goed antwoord voor het leaderboard!</p>
            </div>

            <form method="post">
                {% for q in questions %}
                    <div class="mb-4 p-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05);">
                        <h6 class="fw-bold mb-3 text-white">Vraag {{ loop.index }}: {{ q.question }}</h6>
                        <div class="d-flex flex-column gap-2">
                            {% for option in q.options %}
                                <div class="form-check">
                                    {# HIER ZAT DE FOUT: {% loop.index %} gewijzigd naar {{ loop.index }} #}
                                    <input class="form-check-input" type="radio" name="q_{{ q.id }}" id="q{{ q.id }}_{{ loop.index }}" value="{{ option }}" required>
                                    <label class="form-check-label text-secondary" for="q{{ q.id }}_{{ loop.index }}">
                                        {{ option }}
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}

                <button type="submit" class="btn btn-info w-100 py-2.5 fw-bold rounded-pill text-dark">
                    <i class="bi bi-send-fill"></i> Antwoorden Inzenden
                </button>
            </form>
        </div>

    </div>

</body>
</html>
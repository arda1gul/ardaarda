<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spelen.nl - Quiz Resultaat</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }
        .gaming-card {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 1rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center vh-100 px-3">

    <div class="gaming-card p-4 p-md-5 text-center" style="max-width: 450px; width: 100%;">
        <div class="mb-3 text-warning display-3"><i class="bi bi-trophy-fill"></i></div>
        <h2 class="fw-bold mb-2">Quiz Voltooid!</h2>
        <p class="text-secondary small mb-4">Goed gespeeld, {{ username }}. Je punten zijn direct toegevoegd aan het scorebord.</p>
        
        <div class="p-3 mb-4 rounded-3 bg-dark border border-secondary border-opacity-25">
            <span class="text-secondary small d-block">Behaalde punten:</span>
            <span class="display-4 fw-bold text-success">+{{ scoreEarned }}</span>
        </div>

        <a href="{{ path('app_home') }}" class="btn btn-primary w-100 py-2.5 rounded-pill fw-bold">
            <i class="bi bi-house-door-fill"></i> Terug naar de Game Hub
        </a>
    </div>

</body>
</html>
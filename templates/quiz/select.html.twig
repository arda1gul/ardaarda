<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spelen.nl - Quiz Categorieën</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }
        .gaming-card {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 1rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .variant-pill {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.5rem;
            transition: all 0.2s ease;
        }
        .variant-pill:hover:not(.disabled) {
            background: rgba(99, 102, 241, 0.2);
            border-color: #6366f1;
        }
    </style>
</head>
<body class="py-4 py-md-5">

    <div class="container" style="max-width: 900px;">
        
        <!-- Header / Terugknop -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="{{ path('app_home') }}" class="btn btn-outline-light btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Terug naar Hub
            </a>
            <span class="text-secondary small">Speler: <strong class="text-white">{{ username }}</strong> | <span class="text-warning">Seizoen: Zondag t/m Zondag</span></span>
        </div>

        {% for label, message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="text-center mb-5">
            <h1 class="fw-bold mb-2"><i class="bi bi-patch-question-fill text-info"></i> Wekelijkse Quiz Arena</h1>
            <p class="text-secondary">Kies een onderwerp, selecteer een niet-gespeelde variant (20 vragen) en verdien punten voor het leaderboard!</p>
        </div>

        {% set activeCategories = [] %}
        {% set completedCategories = [] %}

        {% for key, cat in categoriesStatus %}
            {% if cat.completedAll %}
                {% set completedCategories = completedCategories|merge([{key: key, data: cat}]) %}
            {% else %}
                {% set activeCategories = activeCategories|merge([{key: key, data: cat}]) %}
            {% endif %}
        {% endfor %}

        <!-- ACTIEVE QUIZZEN -->
        <h3 class="fw-bold mb-3 text-white"><i class="bi bi-controller text-primary"></i> Beschikbare Quizzen</h3>
        <div class="row g-4 mb-5">
            {% for item in activeCategories %}
                {% set key = item.key %}
                {% set cat = item.data %}
                <div class="col-md-6">
                    <div class="gaming-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="fs-2 {{ cat.color }} bg-dark p-3 rounded-3 border border-secondary border-opacity-25">
                                <i class="bi {{ cat.icon }}"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold text-white mb-0">{{ cat.title }}</h4>
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 mt-1">Totaal: {{ cat.totalPoints }} pts</span>
                            </div>
                        </div>
                        <p class="text-secondary small mb-3 flex-grow-1">{{ cat.description }}</p>

                        <!-- Variant Selectie -->
                        <div class="d-flex flex-column gap-2 mt-auto">
                            <small class="text-secondary fw-bold text-uppercase" style="font-size: 0.7rem;">Kies een variant:</small>
                            {% for vNum, vData in cat.variants %}
                                <div class="variant-pill p-2 px-3 d-flex align-items-center justify-content-between">
                                    <span class="small fw-semibold text-white">{{ vData.title }}</span>
                                    {% if vData.played %}
                                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25">
                                            <i class="bi bi-check-circle-fill"></i> Afgerond ({{ vData.points }} pts)
                                        </span>
                                    {% else %}
                                        <a href="{{ path('app_quiz_play', {topic: key, variant: vNum}) }}" class="btn btn-outline-info btn-sm py-1 px-3 rounded-pill fw-bold" style="font-size: 0.75rem;">
                                            <i class="bi bi-play-fill"></i> Speel (20 vr.)
                                        </a>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- AFGERONDE QUIZZEN -->
        {% if completedCategories|length > 0 %}
            <h3 class="fw-bold mb-3 text-success"><i class="bi bi-check-all"></i> Voltooide Quizzen (Alles Afgerond)</h3>
            <div class="row g-4">
                {% for item in completedCategories %}
                    {% set cat = item.data %}
                    <div class="col-md-6">
                        <div class="gaming-card p-4 h-100 d-flex flex-column border-success border-opacity-50" style="background: linear-gradient(135deg, #064e3b 0%, #0f172a 100%);">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="fs-2 text-success bg-dark p-3 rounded-3 border border-success border-opacity-25">
                                    <i class="bi bi-trophy-fill"></i>
                                </div>
                                <div>
                                    <h4 class="fw-bold text-white mb-0">{{ cat.title }}</h4>
                                    <span class="badge bg-success text-white mt-1">Volledig Afgerond!</span>
                                </div>
                            </div>
                            <p class="text-white-50 small mb-3">Alle 3 varianten zijn uitgespeeld.</p>
                            <div class="mt-auto p-3 bg-dark bg-opacity-50 rounded-3 border border-success border-opacity-25 d-flex justify-content-between align-items-center">
                                <span class="text-secondary small">Totale score:</span>
                                <span class="fs-4 fw-bold text-warning">{{ cat.totalPoints }} pts</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>

</body>
</html>
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spelen.nl - Word Duel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #0f172a; color: #f8fafc; }
        .gaming-card { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 1rem; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3); }
    </style>
</head>
<body class="py-4 py-md-5">

    <div class="container" style="max-width: 650px;">
        
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="{{ path('app_home') }}" class="btn btn-outline-light btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Terug naar Hub
            </a>
            <span class="text-secondary small">Speler: <strong class="text-white">{{ username }}</strong> | Tegenstander: <strong class="text-info">{{ opponent }}</strong></span>
        </div>

        <div class="text-center mb-4">
            <h1 class="fw-bold mb-1"><i class="bi bi-controller text-warning"></i> Dagelijkse Wordle</h1>
            <p class="text-secondary small">Raad het woord van <strong>{{ opponent }}</strong> (50 punten) en verzin een nieuw woord voor hem/haar</p>
        </div>

        <!-- SECTIE 1: Raad het woord van de tegenstander -->
        <div class="gaming-card p-4 mb-4">
            <h4 class="fw-bold text-white mb-3"><i class="bi bi-puzzle-fill text-info"></i> Raad het woord van {{ opponent }}</h4>

            {% if incomingWord and incomingWord.isCompleted %}
                <div class="p-3 rounded-3 text-center {{ incomingWord.isGuessed ? 'bg-success bg-opacity-10 border border-success' : 'bg-danger bg-opacity-10 border border-danger' }}">
                    {% if incomingWord.isGuessed %}
                        <h5 class="text-success fw-bold mb-1"><i class="bi bi-check-circle-fill"></i> Geweldig! Geraden!</h5>
                        <p class="text-secondary small mb-0">Je hebt <strong>50 punten</strong> verdiend voor dit woord.</p>
                    {% else %}
                        <h5 class="text-danger fw-bold mb-1"><i class="bi bi-x-circle-fill"></i> Helaas! Niet juist geraden.</h5>
                        <p class="text-secondary small mb-0">Het geheime woord was: <strong class="text-white text-uppercase">{{ incomingWord.word }}</strong></p>
                    {% endif %}
                    <hr class="border-secondary opacity-25 my-2">
                    <small class="text-muted">Kom na 00:00 uur weer terug voor een nieuw woord!</small>
                </div>
            {% elseif incomingWord %}
                <!-- Formulier om te raden -->
                <form method="post">
                    <p class="text-secondary small">Het woord is ingesteld door {{ opponent }}. Doe je gok!</p>
                    <div class="input-group mb-3">
                        <input type="text" name="guess" class="form-control bg-dark text-white border-secondary" placeholder="Typ je woord hier..." required autofocus>
                        <button type="submit" name="guess_word" class="btn btn-info fw-bold px-4 text-dark">Indienen</button>
                    </div>
                </form>
            {% else %}
                <div class="alert alert-dark border border-secondary text-secondary small mb-0 text-center">
                    <i class="bi bi-clock-history"></i> {{ opponent }} heeft nog geen woord voor je ingesteld vandaag. Wacht even tot hij/zij dit heeft gedaan!
                </div>
            {% endif %}
        </div>

        <!-- SECTIE 2: Bepaal het woord voor de tegenstander -->
        <div class="gaming-card p-4">
            <h4 class="fw-bold text-white mb-3"><i class="bi bi-pencil-square text-warning"></i> Bepaal het woord voor {{ opponent }}</h4>

            {% if outgoingWord %}
                <div class="p-3 rounded-3 bg-dark border border-secondary text-center">
                    <span class="text-secondary small d-block">Jouw ingestelde woord voor vandaag:</span>
                    <h3 class="fw-bold text-warning text-uppercase mb-1 tracking-widest">{{ outgoingWord.word }}</h3>
                    <small class="text-muted">Je kunt dit woord morgen na 00:00 uur weer aanpassen.</small>
                </div>
            {% else %}
                <form method="post">
                    <p class="text-secondary small">Geef een geheim woord op dat {{ opponent }} vandaag moet zien te raden:</p>
                    <div class="input-group mb-3">
                        <input type="text" name="secret_word" class="form-control bg-dark text-white border-secondary" placeholder="Bijv. 'kasteel'" required>
                        <button type="submit" name="set_word" class="btn btn-warning fw-bold px-4 text-dark">Woord Opslaan</button>
                    </div>
                </form>
            {% endif %}
        </div>

    </div>

</body>
</html>